{
  "name": "nova-os",
  "private": true,
  "version": "0.1.0",
  "description": "NovaOS — simulated operating system (boot, lockscreen, desktop, apps) running as a web app and as an Android app via Capacitor.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync android",
    "android": "npm run build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "v86": "^0.5.476",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/cli": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.49.1",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
